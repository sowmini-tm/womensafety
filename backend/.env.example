# ---------------------------------------------------------------------------
# Women Safety App - backend environment template
# Copy to .env and fill in real values. NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Database (SQLAlchemy URL). Managed MySQL providers may require SSL options,
# e.g. mysql+pymysql://user:password@host:3306/dbname?ssl=verify_identity&ssl_ca=/path/ca.pem
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/women_security_db

# development | production
# When production: the app refuses to start unless JWT_SECRET_KEY is overridden
# with a strong value of at least 32 characters.
ENVIRONMENT=development
JWT_SECRET_KEY=change_this_use_32_plus_random_chars_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# true = OTP codes are handled locally instead of being sent via SMS.
# MUST be false in production so OTP delivery uses the real SMS flow.
DEV_OTP_MODE=true

UPLOAD_DIR=uploads

# Exact origins allowed by CORS - comma-separated list of frontend origin URLs
# (a JSON array string is also accepted). Never use "*" in production;
# credentialed requests require an explicit origin list.
# Example: https://your-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# SMS / email notifications (SOS alerts). Leave blank to run without outbound
# delivery - attempts are then truthfully reported as FAILED, never simulated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# Routing service used by POST /api/safety/route-plan. The public OSRM demo
# instance below is fine for development but is NOT production-grade (rate
# limits, no SLA). Point OSRM_BASE_URL at a self-hosted or managed OSRM for
# production deployments. No paid provider is required.
OSRM_BASE_URL=https://router.project-osrm.org

# Server binding used by backend/start.sh (cloud platforms like Render inject
# PORT automatically; HOST stays 0.0.0.0 to accept external traffic).
HOST=0.0.0.0
PORT=8000
# Number of gunicorn/uvicorn worker processes (Render also honors WEB_CONCURRENCY).
WEB_CONCURRENCY=2

